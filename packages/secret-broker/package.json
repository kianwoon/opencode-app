{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-secret-broker",
  "version": "0.1.0",
  "description": "Standalone OpenCode plugin that injects allowlisted .env secrets into child processes and redacts them from the model-visible channel.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode",
    "directory": "packages/secret-broker"
  },
  "exports": {
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsgo --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
